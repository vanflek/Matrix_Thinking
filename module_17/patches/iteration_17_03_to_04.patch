+        old_y = piece.y
+        old_rotation = piece.rotation
+
+        piece.move(dx, dy)
+        if rotate:
+            piece.rotate()
+
+        height, width = piece.get_matrix().shape
+        rows, cols = model.glass.shape[1:]
+        inside = (
+            piece.x >= 0
+            and piece.y >= 0
+            and piece.x + width <= cols
+            and piece.y + height <= rows
+        )
+
+        if not inside:
+            piece.x = old_x
+            piece.y = old_y
+            piece.rotation = old_rotation
+            return False
