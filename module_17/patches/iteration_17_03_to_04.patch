+            piece.x >= 0
+            and piece.y >= 0
+            and piece.x + width <= cols
+            and piece.y + height <= rows
+        )
+
+        if not inside:
+            piece.x = old_x
+            piece.y = old_y
+            piece.rotation = old_rotation
+            return False
