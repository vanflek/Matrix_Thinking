+    def try_transform(self, model, dx=0, dy=0, rotate=False):
+        piece = model.current_tetromino
+        old_x = piece.x
+        old_y = piece.y
+        old_rotation = piece.rotation
+
+        piece.move(dx, dy)
+        if rotate:
+            piece.rotate()
+
+        height, width = piece.get_matrix().shape
+        rows, cols = model.glass.shape[1:]
