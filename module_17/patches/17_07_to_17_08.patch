+    def clear_full_rows(self, model):
+        fixed_layer = model.glass[FIXED_LAYER]
+        full_rows = np.all(fixed_layer != 0, axis=1)
+        cleared = np.count_nonzero(full_rows)
+
+        if cleared == 0:
+            return 0
+
+        remaining_rows = fixed_layer[~full_rows]
+        empty_rows = np.zeros(
+            (cleared, fixed_layer.shape[1]),
+            dtype=fixed_layer.dtype,
+        )
+        fixed_layer[:] = np.vstack((empty_rows, remaining_rows))
+        model.score += 100 * cleared * cleared
+        return cleared
