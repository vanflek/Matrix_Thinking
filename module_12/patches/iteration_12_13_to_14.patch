+def get_gray(pixels):
+    width, height = pixels.shape[:2]
+    gray = np.zeros((width, height), dtype=float)
 
+    for x in range(width):
+        for y in range(height):
+            red, green, blue = pixels[x, y]
+
+            gray[x, y] = (
+                0.299 * red
+                + 0.587 * green
+                + 0.114 * blue
+            )
+
+    return gray
 
 
