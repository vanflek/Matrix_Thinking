+def get_cell_size(font):
+    width = 0
+    height = 0
+
+    for code in range(32, 127):
+        symbol_width, symbol_height = font.size(chr(code))
+        width = max(width, symbol_width)
+        height = max(height, symbol_height)
+
+    return width, height
+
+
+def get_block_averages(gray, cell_width, cell_height):
+    columns = gray.shape[0] // cell_width
+    rows = gray.shape[1] // cell_height
+    averages = np.zeros((columns, rows), dtype=float)
+
+    for x in range(columns):
+        for y in range(rows):
+            left = x * cell_width
+            top = y * cell_height
+
+            block = gray[
+                left:left + cell_width,
+                top:top + cell_height
+            ]
+
+            total = 0.0
+            for local_x in range(cell_width):
+                for local_y in range(cell_height):
+                    total += block[local_x, local_y]
+
+            averages[x, y] = total / (cell_width * cell_height)
+
+    return averages
+
+
