+def get_color_averages(pixels, cell_width, cell_height):
+    columns = pixels.shape[0] // cell_width
+    rows = pixels.shape[1] // cell_height
+
+    colors = np.zeros((columns, rows, 3), dtype=float)
+
+    for x in range(columns):
+        for y in range(rows):
+            left = x * cell_width
+            top = y * cell_height
+
+            block = pixels[
+                left:left + cell_width,
+                top:top + cell_height
+            ]
+
+            for channel in range(3):
+                colors[x, y, channel] = (
+                    block[:, :, channel].mean()
+                )
+
+    return colors
+
