+    def resolve_projectile_enemy_collisions(self):
+        hit_projectiles = set()
+        hit_enemies = set()
+
+        for projectile in self.model.projectiles:
+            for enemy in self.model.enemies:
+                if enemy in hit_enemies:
+                    continue
+
+                distance = np.hypot(
+                    projectile.dx - enemy.dx,
+                    projectile.dy - enemy.dy,
+                )
+                collision_distance = (
+                    projectile.collision_radius + enemy.collision_radius
+                )
+                if distance <= collision_distance:
+                    hit_projectiles.add(projectile)
+                    hit_enemies.add(enemy)
+                    self.model.score += 100
+                    break
+
+        # Build new lists only after checking all candidate pairs.
+        self.model.projectiles = [
+            projectile for projectile in self.model.projectiles
+            if projectile not in hit_projectiles
+        ]
+        self.model.enemies = [
+            enemy for enemy in self.model.enemies
+            if enemy not in hit_enemies
+        ]
+
