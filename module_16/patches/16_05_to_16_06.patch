+    def load_enemy_pattern(self, model, pattern):
+        assert len(pattern.shape) == 2
+        pattern_rows, pattern_cols = pattern.shape
+        assert 0 < pattern_rows <= model.rows - 2
+        assert 0 < pattern_cols <= model.cols
+        assert np.any(pattern)
+        assert np.all((pattern == 0) | (pattern == 1))
+        start_row = 1
+        start_col = (model.cols - pattern_cols) // 2
+        model.layers[ENEMIES_LAYER] = 0
+        model.layers[
+            ENEMIES_LAYER,
+            start_row:start_row + pattern_rows,
+            start_col:start_col + pattern_cols
+        ] = pattern
+
+    def start_next_wave(self, model):
+        model.wave_index = (
+            model.wave_index + 1
+        ) % len(model.enemy_patterns)
+        pattern = model.enemy_patterns[model.wave_index]
+        self.load_enemy_pattern(model, pattern)
+
+        model.layers[BULLET_LAYER] = 0
+        model.layers[ENEMY_BULLET_LAYER] = 0
+        model.shooting_permission = True
+        model.enemy_direction = "RIGHT"
+        model.enemy_tick = 0
+        model.enemy_bullet_tick = 0
