+    def shift_no_wrap(self, matrix, direction):
+        result = np.zeros_like(matrix)
+        if direction == "RIGHT":
+            result[:, 1:] = matrix[:, :-1]
+        elif direction == "LEFT":
+            result[:, :-1] = matrix[:, 1:]
+        elif direction == "DOWN":
+            result[1:, :] = matrix[:-1, :]
+        else:
+            result[:] = matrix
+        return result
