+def handle_controls(events, state, cell_size, rows, cols):
+    """Translate input events into commands for the current frame."""
+    state["paint_commands"] = []
+    state["clear"] = False
+
+    for event in events:
+        if event.type == pg.MOUSEBUTTONDOWN:
+            if event.button == 1 or event.button == 3:
+                # Use the click position, even if the mouse has moved since.
+                x, y = event.pos
+                col = x // cell_size
+                row = y // cell_size
+                row, col = clamp_cell(row, col, rows, cols)
+                state["cell"] = (row, col)
+                state["paint_commands"].append((row, col, event.button))
+
+        if event.type == pg.KEYDOWN:
+            if event.key == pg.K_c:
+                state["clear"] = True
+
+
+def apply_actions(maze, state):
+    """Change maze values according to the current commands."""
+    if state["clear"]:
+        maze[:] = 0
+        return
+
+    for row, col, button in state["paint_commands"]:
+        if button == 3:
+            maze[row, col] = 0
+        elif button == 1:
+            maze[row, col] = 1
+
